# Reference only: export these variables in your shell; .env is NOT auto-loaded.
REPO_AGENT_BASE_URL=https://your-provider.example/v1
REPO_AGENT_MODEL=your-tool-calling-model
REPO_AGENT_API_KEY=

# Optional requirement extraction (Chat Completions with JSON object mode).
# Disabled until you explicitly enable it; uses separate credentials/configuration.
REPO_AGENT_REQUIREMENTS_ENABLED=0
REPO_AGENT_REQUIREMENTS_BASE_URL=https://your-provider.example/v1
REPO_AGENT_REQUIREMENTS_MODEL=your-json-capable-model
REPO_AGENT_REQUIREMENTS_API_KEY=

# Optional MySQL. Unset/empty uses SQLite at STATE/sessions-v2.db.
# Passwords containing URL punctuation must be percent-encoded.
REPO_AGENT_DATABASE_URL=
# Example: mysql+pymysql://repo_agent:ENCODED_PASSWORD@127.0.0.1:3308/repo_workbench?charset=utf8mb4
