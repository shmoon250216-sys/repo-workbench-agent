{"id": "RW-001", "category": "bug-fix", "task": "修复加法计算错误", "path": "logic.py", "before": "def add(a,b):\n    return a-b\n", "old": "return a-b", "new": "return a+b", "check": "assert m.add(2,3)==5; assert m.add(-2,1)==-1"}
{"id": "RW-002", "category": "boundary-fix", "task": "空列表平均值返回 0", "path": "logic.py", "before": "def mean(xs):\n    return sum(xs)/len(xs)\n", "old": "return sum(xs)/len(xs)", "new": "return sum(xs)/len(xs) if xs else 0", "check": "assert m.mean([])==0; assert m.mean([2,4])==3"}
{"id": "RW-003", "category": "feature", "task": "增加 clamp 边界截断函数", "path": "logic.py", "before": "", "old": "", "new": "def clamp(x,lo,hi):\n    return max(lo,min(hi,x))\n", "check": "assert m.clamp(-1,0,10)==0; assert m.clamp(20,0,10)==10; assert m.clamp(3,0,10)==3"}
{"id": "RW-004", "category": "feature", "task": "增加工单状态筛选", "path": "logic.py", "before": "def select(items,status=None):\n    return items\n", "old": "return items", "new": "return [x for x in items if status is None or x[\"status\"]==status]", "check": "assert m.select([{ \"status\":\"open\"},{\"status\":\"closed\"}],\"open\")==[{\"status\":\"open\"}]; assert m.select([])==[]"}
{"id": "RW-005", "category": "boundary-fix", "task": "修复最后一页漏项", "path": "logic.py", "before": "def page(xs,n,size):\n    return xs[(n-1)*size:n*size-1]\n", "old": "n*size-1", "new": "n*size", "check": "assert m.page([1,2,3],2,2)==[3]; assert m.page([1,2,3],1,2)==[1,2]"}
{"id": "RW-006", "category": "refactor", "task": "合并重复返回并保持行为", "path": "logic.py", "before": "def positive(x):\n    if x>0:\n        return True\n    return False\n", "old": "    if x>0:\n        return True\n    return False", "new": "    return x>0", "check": "assert m.positive(1); assert not m.positive(0); assert not m.positive(-2)"}
